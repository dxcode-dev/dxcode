{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/target",
      "!**/coverage",
      "!**/node_modules",
      "!**/.alchemy",
      "!**/.dx",
      "!**/.wrangler",
      "!**/.astro",
      "!wiki/raw",
      "!**/*.generated.js",
      "!internal/release/public-release/releases",
      "!packages/api/src/views/kit"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useOptionalChain": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTemplateCurlyInString": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/core/src/**/*.ts", "!apps/core/src/**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/**/*.ts",
        "packages/*/src/**/*.ts",
        "scripts/fixtures/biome/*.ts",
        "!**/*.test.ts"
      ],
      "plugins": ["./scripts/biome/no-manual-effect-error-tag.grit"]
    },
    {
      "includes": ["apps/web/src/**/*.tsx", "scripts/fixtures/biome/*.tsx"],
      "plugins": ["./scripts/biome/no-direct-react-use-effect.grit"]
    },
    {
      "includes": [
        "apps/web/src/**/*.ts",
        "apps/web/src/**/*.tsx",
        "!apps/web/src/**/*.test.ts",
        "!apps/web/src/**/*.test.tsx",
        "scripts/fixtures/biome/*.tsx"
      ],
      "plugins": ["./scripts/biome/no-manual-react-memo.grit"]
    }
  ]
}
