new file mode 100644
index 0000000..fba6bd3
--- /dev/null
+++ b/src/mac/windows.rs
@@ -0,0 +1,346 @@
+//! Window mode: one window of the Mac streamed and controlled instead of a whole display.
+//!
+//! - `GET /windows` lists the on-screen windows a viewer may pick (`list`).
+//! - A viewer picks one with the text command `dw,<window id>` and returns to a display
+//!   with `ds,<display id>` (see server.rs); `hello.displays.window` names the window
+//!   being streamed, and `{"t":"windowClosed","id":N}` tells viewers the window went
+//!   away and the stream is back on the display.
+//! - Capture uses `SCContentFilter initWithDesktopIndependentWindow` (stream.rs), sized
+//!   to the window's frame at the display's scale, and starts again when the window is
+//!   resized (capture.rs).
+//! - Input maps the viewer's pixels onto the window's frame on screen; clicks raise the
+//!   window first, and the pointer goes back where it was once a click or drag ends
+//!   (input.rs), so a person using the Mac keeps their own pointer.
+
+use super::ffi::*;
+use objc2::rc::Retained;
+use objc2_app_kit::{NSApplicationActivationOptions, NSRunningApplication};
+use objc2_core_foundation::{CFBoolean, CFString};
+use objc2_foundation::NSError;
+use objc2_screen_capture_kit::{SCShareableContent, SCWindow};
+use std::ffi::c_void;
+use std::sync::mpsc;
+use std::time::Duration;
+
+/// Smallest window, in points, a viewer may pick (and that capture follows).
+pub const MIN_POINTS: f64 = 48.0;
+
+/// The window being streamed.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Target {
+    pub id: u32,
+    pub pid: i32,
+    pub app: String,
+    pub title: String,
+}
+
+/// One window `GET /windows` lists.
+#[derive(Clone, Debug)]
+pub struct Info {
+    pub target: Target,
+    pub bundle_id: String,
+    /// Global points, top-left origin (as CGDisplayBounds).
+    pub frame: CGRect,
+    pub display: u32,
+}
+
+impl Info {
+    pub fn json(&self) -> serde_json::Value {
+        serde_json::json!({
+            "id": self.target.id,
+            "app": self.target.app,
+            "bundleId": self.bundle_id,
+            "title": self.target.title,
+            "frame": {
+                "x": self.frame.origin.x,
+                "y": self.frame.origin.y,
+                "w": self.frame.size.width,
+                "h": self.frame.size.height,
+            },
+            "display": self.display,
+        })
+    }
+}
+
+/// Objective-C objects handed between threads: ScreenCaptureKit objects may be used
+/// from any thread.
+struct SendBox<T>(T);
+unsafe impl<T> Send for SendBox<T> {}
+
+/// The shareable on-screen content, without desktop windows (wallpaper, icons).
+pub fn shareable() -> Result<Retained<SCShareableContent>, String> {
+    let (tx, rx) = mpsc::channel::<Result<SendBox<Retained<SCShareableContent>>, String>>();
+    let block = block2::RcBlock::new(move |content: *mut SCShareableContent, err: *mut NSError| {
+        let r = match unsafe { Retained::retain(content) } {
+            Some(c) => Ok(SendBox(c)),
+            None => Err(unsafe { err.as_ref() }
+                .map(|e| e.localizedDescription().to_string())
+                .unwrap_or_else(|| "no shareable content".into())),
+        };
+        let _ = tx.send(r);
+    });
+    unsafe {
+        SCShareableContent::getShareableContentExcludingDesktopWindows_onScreenWindowsOnly_completionHandler(
+            true, true, &block,
+        )
+    };
+    match rx.recv_timeout(Duration::from_secs(10)) {
+        Ok(r) => r.map(|b| b.0).map_err(|e| {
+            format!("{e} (is Screen Recording allowed in System Settings > Privacy & Security?)")
+        }),
+        Err(_) => Err("timed out listing windows".into()),
+    }
+}
+
+fn to_rect(r: objc2_core_foundation::CGRect) -> CGRect {
+    CGRect {
+        origin: CGPoint {
+            x: r.origin.x,
+            y: r.origin.y,
+        },
+        size: CGSize {
+            width: r.size.width,
+            height: r.size.height,
+        },
+    }
+}
+
+/// The display holding the middle of `frame` (the main display when none does).
+fn display_of(frame: &CGRect) -> u32 {
+    let (cx, cy) = (
+        frame.origin.x + frame.size.width / 2.0,
+        frame.origin.y + frame.size.height / 2.0,
+    );
+    super::active_displays()
+        .into_iter()
+        .find(|&id| {
+            let b = unsafe { CGDisplayBounds(id) };
+            cx >= b.origin.x
+                && cx < b.origin.x + b.size.width
+                && cy >= b.origin.y
+                && cy < b.origin.y + b.size.height
+        })
+        .unwrap_or_else(|| unsafe { CGMainDisplayID() })
+}
+
+/// A window a viewer may pick: a normal app window, on screen, not tiny, not voxl's.
+fn pickable(w: &SCWindow) -> Option<Info> {
+    unsafe {
+        if !w.isOnScreen() || w.windowLayer() != 0 {
+            return None;
+        }
+        let app = w.owningApplication()?;
+        let pid = app.processID();
+        if pid as u32 == std::process::id() {
+            return None;
+        }
+        let frame = to_rect(w.frame());
+        if frame.size.width < MIN_POINTS || frame.size.height < MIN_POINTS {
+            return None;
+        }
+        Some(Info {
+            target: Target {
+                id: w.windowID(),
+                pid,
+                app: app.applicationName().to_string(),
+                title: w.title().map(|t| t.to_string()).unwrap_or_default(),
+            },
+            bundle_id: app.bundleIdentifier().to_string(),
+            frame,
+            display: display_of(&frame),
+        })
+    }
+}
+
+/// The windows a viewer may stream, by app and title.
+pub fn list() -> Result<Vec<Info>, String> {
+    let content = shareable()?;
+    let mut out: Vec<Info> = unsafe { content.windows() }
+        .iter()
+        .filter_map(|w| pickable(&w))
+        .collect();
+    out.sort_by(|a, b| {
+        (a.target.app.to_lowercase(), &a.target.title, a.target.id).cmp(&(
+            b.target.app.to_lowercase(),
+            &b.target.title,
+            b.target.id,
+        ))
+    });
+    Ok(out)
+}
+
+/// `GET /windows`: `{"windows":[{id, app, bundleId, title, frame {x,y,w,h}, display}]}`.
+pub fn list_json() -> Result<serde_json::Value, String> {
+    let windows: Vec<_> = list()?.iter().map(Info::json).collect();
+    Ok(serde_json::json!({ "windows": windows }))
+}
+
+/// The pickable window `id` with its ScreenCaptureKit object, for capture.
+pub fn find(id: u32) -> Result<(Retained<SCWindow>, Info), String> {
+    let content = shareable()?;
+    let windows = unsafe { content.windows() };
+    windows
+        .iter()
+        .find(|w| unsafe { w.windowID() } == id)
+        .and_then(|w| pickable(&w).map(|info| (w, info)))
+        .ok_or_else(|| format!("window {id} is not on screen"))
+}
+
+/// Where window `id` is now (global points), or None once it closed or left the
+/// screen (minimized, hidden, another Space). Cheap enough to poll.
+pub fn bounds(id: u32) -> Option<CGRect> {
+    describe(id).map(|(frame, _)| frame)
+}
+
+/// Window `id` as a capture target, from the window server (fast, unlike
+/// SCShareableContent): None unless it is an on-screen, normal-layer window that is
+/// not tiny and not voxl's.
+pub fn target(id: u32) -> Option<Target> {
+    let (frame, target) = describe(id)?;
+    (frame.size.width >= MIN_POINTS
+        && frame.size.height >= MIN_POINTS
+        && target.pid as u32 != std::process::id())
+    .then_some(target)
+}
+
+unsafe fn dict_number(info: CFDictionaryRef, key: CFStringRef) -> Option<i64> {
+    let v = CFDictionaryGetValue(info, key);
+    let mut n = 0i64;
+    (!v.is_null() && CFNumberGetValue(v, kCFNumberSInt64Type, &mut n as *mut i64 as _)).then_some(n)
+}
+
+/// The window server's frame and owner of window `id`, while it is on screen at the
+/// normal layer.
+fn describe(id: u32) -> Option<(CGRect, Target)> {
+    unsafe {
+        let list = CGWindowListCopyWindowInfo(kCGWindowListOptionIncludingWindow, id);
+        if list.is_null() {
+            return None;
+        }
+        let mut found = None;
+        for i in 0..CFArrayGetCount(list) {
+            let info = CFArrayGetValueAtIndex(list, i) as CFDictionaryRef;
+            if dict_number(info, kCGWindowNumber) != Some(id as i64) {
+                continue;
+            }
+            let onscreen = CFDictionaryGetValue(info, kCGWindowIsOnscreen);
+            if onscreen.is_null()
+                || !CFBooleanGetValue(onscreen)
+                || dict_number(info, kCGWindowLayer) != Some(0)
+            {
+                break;
+            }
+            let dict = CFDictionaryGetValue(info, kCGWindowBounds);
+            let mut r = CGRect::default();
+            if !dict.is_null() && CGRectMakeWithDictionaryRepresentation(dict, &mut r) {
+                found = Some((
+                    r,
+                    Target {
+                        id,
+                        pid: dict_number(info, kCGWindowOwnerPID).unwrap_or(0) as i32,
+                        app: cf_string(CFDictionaryGetValue(info, kCGWindowOwnerName)),
+                        title: cf_string(CFDictionaryGetValue(info, kCGWindowName)),
+                    },
+                ));
+            }
+            break;
+        }
+        CFRelease(list);
+        found
+    }
+}
+
+// ---------- bringing the window forward ----------
+
+type AXGetWindow = unsafe extern "C" fn(AXUIElementRef, *mut u32) -> i32;
+
+/// `_AXUIElementGetWindow`: the CGWindowID of an AX window. Private but long stable
+/// (window managers use it); looked up so the link never depends on it.
+fn ax_get_window() -> Option<AXGetWindow> {
+    let symbol = unsafe { libc::dlsym(libc::RTLD_DEFAULT, c"_AXUIElementGetWindow".as_ptr()) };
+    (!symbol.is_null()).then(|| unsafe { std::mem::transmute::<*mut c_void, AXGetWindow>(symbol) })
+}
+
+unsafe fn ax_attr(el: AXUIElementRef, name: &'static str) -> CFTypeRef {
+    let key = CFString::from_static_str(name);
+    let mut out: CFTypeRef = std::ptr::null();
+    if AXUIElementCopyAttributeValue(el, &*key as *const CFString as CFStringRef, &mut out) != 0 {
+        return std::ptr::null();
+    }
+    out
+}
+
+/// The AX window's frame, to match a window when `_AXUIElementGetWindow` is missing.
+unsafe fn ax_frame(el: AXUIElementRef) -> Option<CGRect> {
+    let (pos, size) = (ax_attr(el, "AXPosition"), ax_attr(el, "AXSize"));
+    let mut r = CGRect::default();
+    let ok = !pos.is_null()
+        && !size.is_null()
+        && AXValueGetValue(pos, kAXValueCGPointType, &mut r.origin as *mut CGPoint as _)
+        && AXValueGetValue(size, kAXValueCGSizeType, &mut r.size as *mut CGSize as _);
+    for v in [pos, size] {
+        if !v.is_null() {
+            CFRelease(v);
+        }
+    }
+    ok.then_some(r)
+}
+
+/// Brings window `id` of process `pid` to the front and its app to the foreground, so injected
+/// clicks and keys land in it. Needs Accessibility, as all input does.
+pub fn raise(id: u32, pid: i32) {
+    if let Some(app) = NSRunningApplication::runningApplicationWithProcessIdentifier(pid) {
+        if !app.isActive() {
+            #[allow(deprecated)]
+            app.activateWithOptions(NSApplicationActivationOptions::ActivateIgnoringOtherApps);
+        }
+    }
+    unsafe {
+        let app = AXUIElementCreateApplication(pid);
+        if app.is_null() {
+            return;
+        }
+        // Frontmost through Accessibility too: macOS 14 may decline activateWithOptions
+        // from a background process.
+        let front = CFString::from_static_str("AXFrontmost");
+        AXUIElementSetAttributeValue(
+            app,
+            &*front as *const CFString as CFStringRef,
+            CFBoolean::new(true) as *const CFBoolean as CFTypeRef,
+        );
+        let windows = ax_attr(app, "AXWindows");
+        if !windows.is_null() {
+            let get_window = ax_get_window();
+            let expected = bounds(id);
+            for i in 0..CFArrayGetCount(windows) {
+                let w = CFArrayGetValueAtIndex(windows, i) as AXUIElementRef;
+                let matches = match get_window {
+                    Some(f) => {
+                        let mut found = 0u32;
+                        f(w, &mut found) == 0 && found == id
+                    }
+                    None => expected.is_some() && ax_frame(w) == expected,
+                };
+                if matches {
+                    let raise = CFString::from_static_str("AXRaise");
+                    AXUIElementPerformAction(w, &*raise as *const CFString as CFStringRef);
+                    let main = CFString::from_static_str("AXMain");
+                    AXUIElementSetAttributeValue(
+                        w,
+                        &*main as *const CFString as CFStringRef,
+                        CFBoolean::new(true) as *const CFBoolean as CFTypeRef,
+                    );
+                    break;
+                }
+            }
+            CFRelease(windows);
+        }
+        CFRelease(app as CFTypeRef);
+    }
+}
+
+/// Whether `pid`'s app is the frontmost one.
+pub fn app_active(pid: i32) -> bool {
+    NSRunningApplication::runningApplicationWithProcessIdentifier(pid)
+        .is_some_and(|app| app.isActive())
+}
