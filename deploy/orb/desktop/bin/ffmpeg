#!/bin/bash
# waymote-streamd runs `ffmpeg` from PATH to send RTP to the gateway on
# 127.0.0.1. ffmpeg binds its RTP and RTCP sockets to 0.0.0.0 unless told
# otherwise; this wrapper (first in the gateway's PATH, see ../session) binds
# them to loopback, so the session opens no socket on another address.
args=()
for arg in "$@"; do
  if [[ $arg == rtp://127.0.0.1:* ]]; then
    case $arg in
      *\?*) arg="$arg&localaddr=127.0.0.1" ;;
      *) arg="$arg?localaddr=127.0.0.1" ;;
    esac
  fi
  args+=("$arg")
done
exec /usr/bin/ffmpeg "${args[@]}"
