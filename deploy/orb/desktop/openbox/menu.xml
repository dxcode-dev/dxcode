<?xml version="1.0" encoding="UTF-8"?>
<!-- The desktop's right-click menu. No Exit entry: exiting openbox would
     leave windows without a manager until the next start. -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="">
    <item label="Terminal">
      <action name="Execute"><command>/opt/dx/desktop/env/bin/xterm -fa 'DejaVu Sans Mono' -fs 11</command></action>
    </item>
    <item label="Chromium">
      <action name="Execute"><command>/opt/dx/desktop/chromium</command></action>
    </item>
    <item label="Reconfigure">
      <action name="Reconfigure"/>
    </item>
  </menu>
</openbox_menu>
