---
import { formatLogDate, isoLogDate, type LogEntry, logPath } from "../lib/log";

interface Props {
  entries: LogEntry[];
}

const { entries } = Astro.props;
---

<ol class="dx-log-list">
  {
    entries.map((entry) => (
      <li>
        <time datetime={isoLogDate(entry.data.date)}>
          {formatLogDate(entry.data.date)}
        </time>
        <p>
          <a href={logPath(entry)}>
            <strong>{entry.data.title}</strong>
          </a>
          <span>{entry.data.summary}</span>
        </p>
      </li>
    ))
  }
</ol>
