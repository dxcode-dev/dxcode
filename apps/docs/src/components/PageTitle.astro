---
import Default from "@astrojs/starlight/components/PageTitle.astro";

// Every page opens with its title, a Copy Page button, and its one-line
// summary (the frontmatter description). The button copies the page's
// Markdown, which src/pages/[...slug].md.ts serves next to the page.
const { entry } = Astro.locals.starlightRoute;
const markdownUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${entry.id}.md`;
const summary = entry.data.description;
---

<div class="dx-title-row">
  <Default />
  <div class="dx-page-actions not-content">
    <button type="button" class="dx-copy-page" data-markdown-url={markdownUrl}>
      <span class="dx-copy-label" aria-live="polite">Copy page</span>
    </button>
    <a class="dx-markdown-link" href={markdownUrl}>Markdown</a>
  </div>
</div>
{summary ? <p class="dx-lead">{summary}</p> : null}

<script>
  // Safari allows a clipboard write only during the click itself, so the
  // Markdown is fetched when the page loads, and a click writes text that
  // is already here. A click before it arrives hands the clipboard a
  // promise through ClipboardItem, which Safari accepts.
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    ".dx-copy-page",
  )) {
    const label = button.querySelector(".dx-copy-label");
    const url = button.dataset.markdownUrl;
    if (url === undefined || label === null) continue;
    let markdown: string | undefined;
    const pending = fetch(url).then(async (response) => {
      if (!response.ok) throw new Error(String(response.status));
      markdown = await response.text();
      return markdown;
    });
    pending.catch(() => undefined);
    button.addEventListener("click", async () => {
      try {
        if (markdown !== undefined) {
          await navigator.clipboard.writeText(markdown);
        } else if (typeof ClipboardItem !== "undefined") {
          await navigator.clipboard.write([
            new ClipboardItem({
              "text/plain": pending.then(
                (text) => new Blob([text], { type: "text/plain" }),
              ),
            }),
          ]);
        } else {
          await navigator.clipboard.writeText(await pending);
        }
        label.textContent = "Copied";
      } catch {
        label.textContent = "Copy failed";
      }
      setTimeout(() => {
        label.textContent = "Copy page";
      }, 2000);
    });
  }
</script>

<style>
  .dx-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .dx-page-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
    font-size: 0.85rem;
  }

  .dx-copy-page {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    cursor: pointer;
  }

  .dx-copy-page:hover,
  .dx-copy-page:focus-visible {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }

  .dx-markdown-link {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .dx-markdown-link:hover {
    color: var(--sl-color-white);
  }

  .dx-lead {
    margin: 0.75rem 0 0;
    max-width: 40rem;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
</style>
