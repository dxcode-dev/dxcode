---
import { Image } from "astro:assets";
import { render } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import {
  formatLogDate,
  getLogEntries,
  isoLogDate,
  type LogEntry,
  logPath,
} from "../../lib/log";

export const getStaticPaths = async () =>
  (await getLogEntries()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));

interface Props {
  entry: LogEntry;
}

const { entry } = Astro.props;
const { title, date, summary, cover, kind, link } = entry.data;
const { Content, headings } = await render(entry);
---

<StarlightPage
  frontmatter={{
    title,
    description: summary,
    editUrl: false,
    prev: false,
    next: false,
    tableOfContents: headings.length > 0,
  }}
  headings={headings}
>
  <div class="not-content dx-log-entry-head">
    <p class="dx-log-meta">
      <a href={logPath()}>dx Log</a>
      <span aria-hidden="true">·</span>
      <time datetime={isoLogDate(date)}>{formatLogDate(date)}</time>
      {kind === "note" && <span class="dx-log-kind">Note</span>}
    </p>
    {
      cover && (
        <Image
          src={cover}
          alt=""
          widths={[800, 1280]}
          sizes="(min-width: 72rem) 46rem, 100vw"
          loading="eager"
        />
      )
    }
  </div>

  <Content />

  <p class="not-content dx-log-entry-foot">
    {link && <a href={link}>Read the docs</a>}
    <a href={logPath()}>All dx Log entries</a>
  </p>
</StarlightPage>
